FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl postgresql-client gosu \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY morphit-src/ /app/

# Morphit is an npm workspace. Runtime packages (including tsx in the current
# indexer/relay workspaces) are installed for all workspaces.
RUN test -f package-lock.json \
 && npm ci --omit=dev \
 && chown -R node:node /app

COPY scripts/indexer-entrypoint.sh /usr/local/bin/indexer-entrypoint
COPY scripts/relay-entrypoint.sh /usr/local/bin/relay-entrypoint
RUN chmod 0755 /usr/local/bin/indexer-entrypoint /usr/local/bin/relay-entrypoint
