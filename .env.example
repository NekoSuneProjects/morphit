# Public hostname only. Do not include https:// or a trailing slash.
MORPHIT_HOSTNAME=morphit.example.com

# BLURT/Morphit operator settings.
MORPHIT_OPERATOR_ACCOUNT=change-me
MORPHIT_FEE_RECIPIENT=change-me
MORPHIT_RELAY_ACCOUNT=change-me

# Generated automatically by ./configure.sh. Hex is deliberately URL-safe because
# the current Morphit indexer requires the password inside DATABASE_URL.
MORPHIT_DB_PASSWORD=CHANGE_ME_GENERATED

# Cloudflare remotely-managed Tunnel token. Treat this like a password.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Morphit defaults. Change only if you know why.
MORPHIT_CHAIN_RPC=https://rpc.blurt.world
MORPHIT_TESTNET=0
MORPHIT_LOG_LEVEL=info
MORPHIT_INSTANCE_METADATA=none

# Relay defaults.
MORPHIT_RELAY_ORIGIN_DISCOVERY=0
MORPHIT_RELAY_ORIGIN_DISCOVERY_FALLBACK=
MORPHIT_RELAY_RATE_LIMIT_WINDOW_MS=60000
MORPHIT_RELAY_RATE_LIMIT_POW_TARGET=1000
MORPHIT_RELAY_RATE_LIMIT_UNSIGNED=1000
MORPHIT_RELAY_MAX_BODY_BYTES=32768
MORPHIT_RELAY_POW_DIFFICULTY_BITS=20
MORPHIT_RELAY_POW_MIN_DIFFICULTY_BITS=18
MORPHIT_RELAY_POW_MAX_DIFFICULTY_BITS=24
MORPHIT_RELAY_POW_MAX_AGE_SECONDS=300
MORPHIT_RELAY_POW_ADJUST_INTERVAL_SECONDS=60
